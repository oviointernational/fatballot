# ---------------------------------------------------------------------------
# FatBallot environment template. Copy to .env (local) and mirror every value
# in the Vercel dashboard (Settings -> Environment Variables) for production.
# ---------------------------------------------------------------------------

# --- Supabase project (REQUIRED: the only database; no local fallback) ---
# Create a FRESH project, run supabase/schema.sql once in its SQL Editor,
# then paste the values from Project Settings -> API.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Service_role is required (server-side only; the browser never sees it).

# --- Superadmin bootstrap (optional) ---
# Pre-fills the placeholder Superadmin identity on first boot. The first-run
# setup screen can also claim the seat without these.
# SUPERADMIN_RA=1001
# SUPERADMIN_EMAIL=
# SUPERADMIN_FIRST_NAME=
# SUPERADMIN_LAST_NAME=
