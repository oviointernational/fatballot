# ---------------------------------------------------------------------------
# FatBallot environment template. Copy to .env (local) and mirror every value
# in the Vercel dashboard (Settings -> Environment Variables) for production.
# ---------------------------------------------------------------------------

# --- Backend persistence + email OTP delivery (REQUIRED in production) ---
SUPABASE_URL=https://gavjqssxqfzbpniammrm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=  (preferred for the email-OTP calls when available)

# Login codes are emailed by Supabase Auth (email OTP, 6 digits). Ensure the
# Email provider is enabled in the Supabase dashboard (Authentication ->
# Providers -> Email, "Confirm email" OFF is fine) and, at election scale,
# configure a custom SMTP sender (Authentication -> Emails) — the built-in
# mailer is rate-limited and shared.

# --- Superadmin bootstrap (optional) ---
# Point the placeholder Superadmin at a real inbox before launch. The
# first-run setup screen can also claim the seat without these.
# SUPERADMIN_RA=1001
# SUPERADMIN_EMAIL=
# SUPERADMIN_FIRST_NAME=
# SUPERADMIN_LAST_NAME=
