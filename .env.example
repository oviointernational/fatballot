# ---------------------------------------------------------------------------
# FatBallot environment template. Copy to .env (local) and mirror every value
# in the Vercel dashboard (Settings -> Environment Variables) with the SAME
# names so the production build picks them up.
# ---------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key.
# These are safe for the browser (the anon key is public by design) and are
# inlined into the built bundle by Vite because they start with VITE_.
VITE_SUPABASE_URL=https://budybxftwwpjfkwinlin.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ1ZHlieGZ0d3dwamZrd2lubGluIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk3MTc1ODMsImV4cCI6MjEwNTI5MzU4M30.T2X380h_Jxp0-_q1J7fbkqpRiiBidhbkUUQp3U-Ds28

# NEVER put the service_role key in the browser or in VITE_ vars.
