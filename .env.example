# ---------------------------------------------------------------------------
# FatBallot environment template. Copy to .env (local) and mirror every value
# in the Vercel dashboard (Settings -> Environment Variables) for production.
# ---------------------------------------------------------------------------

# --- Backend persistence (REQUIRED in production) ---
SUPABASE_URL=https://gavjqssxqfzbpniammrm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=  (fallback if no service-role key)

# --- Superadmin bootstrap (optional) ---
# Point the placeholder Superadmin at a real inbox before launch. The
# first-run setup screen can also claim the seat without these.
# SUPERADMIN_RA=1001
# SUPERADMIN_EMAIL=
# SUPERADMIN_FIRST_NAME=
# SUPERADMIN_LAST_NAME=

# --- Firebase web config (Vite client; all optional, built-in fallback) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
